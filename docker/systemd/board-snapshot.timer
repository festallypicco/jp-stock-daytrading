[Unit]
Description=Run board-snapshot at 14:00/14:30/14:45/14:55 on trading days

[Timer]
# OnCalendarは時刻ごとに1行ずつ書く（複数行はOR条件でトリガーされる）。
# どの時刻の発火かは src/entrypoints/snapshot_batch.py 側で実行時のJST時刻から自己判定する。
# OnCalendar=Mon-Friは土日を除外するが祝日は除外しないため、祝日もタイマーは発火する。
# バッチ内部のis_trading_day()（曜日・年末年始・国民の祝日）で空振りする。
OnCalendar=Mon-Fri 14:00:00 Asia/Tokyo
OnCalendar=Mon-Fri 14:30:00 Asia/Tokyo
OnCalendar=Mon-Fri 14:45:00 Asia/Tokyo
OnCalendar=Mon-Fri 14:55:00 Asia/Tokyo
Persistent=false

[Install]
WantedBy=timers.target
