# 立花証券API: demo または production
TACHIBANA_API_ENV=demo

# 立花証券API: ログインユーザーID
TACHIBANA_API_USER=

# 立花証券API: 口座パスワード
TACHIBANA_API_PASSWORD=

# 立花証券API: 取引パスワード（発注時など）
TACHIBANA_API_LOGIN_PASSWORD=

# 立花証券API: 電話番号認証用の電話番号
TACHIBANA_API_PHONE=

# Telegram: Bot APIトークン
TELEGRAM_BOT_TOKEN=

# Telegram: アラート通知用チャットID
TELEGRAM_ALERTS_CHAT_ID=

# Telegram: レポート通知用チャットID
TELEGRAM_REPORTS_CHAT_ID=
