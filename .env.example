# 立花証券API: demo または production
TACHIBANA_API_ENV=demo

# 立花証券API: ログインユーザーID
TACHIBANA_API_USER=

# 立花証券API: 口座パスワード
TACHIBANA_API_PASSWORD=

# 立花証券API: 取引パスワード（発注時など）
TACHIBANA_API_LOGIN_PASSWORD=

# 立花証券API: 電話番号認証用の電話番号
TACHIBANA_API_PHONE=

# Telegram: Alerts用Bot APIトークン
TELEGRAM_ALERTS_BOT_TOKEN=

# Telegram: 日次レポート用Bot APIトークン
TELEGRAM_REPORT_BOT_TOKEN=

# Telegram: 週次AIチューニングレポート用Bot APIトークン
TELEGRAM_TUNING_BOT_TOKEN=

# Telegram: 3系統共通の宛先チャットID
TELEGRAM_CHAT_ID=

# Groq API: 週次AIチューニングのProposer役で使用（BTC側と共有キーの想定）
GROQ_API_KEY=

# Gemini API: 週次AIチューニングのSkeptic/Moderator役で使用（BTC側と共有キーの想定）
GEMINI_API_KEY=
